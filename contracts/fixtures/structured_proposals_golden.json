        "kind": "blocks",
        "start": { "blockId": "old-heading", "utf16Offset": 0 },
        "end": { "blockId": "old-scene", "utf16Offset": 0 },
        "quote": "Old heading\n\nOld body",
        "sourceHash": "",
        "quoteHash": "",
        "prefix": null,
        "suffix": null
      },
      "expectedQuote": "Old heading\n\nOld body",
