        "body": {
          "type": "doc",
          "content": [
            {
              "type": "paragraph",
              "attrs": { "id": "before" },
              "content": [
                { "type": "text", "text": "Outside bold", "marks": [{ "type": "bold" }] },
                { "type": "text", "text": " and " },
                { "type": "text", "text": "link", "marks": [{ "type": "italic" }, { "type": "link", "attrs": { "href": "https://example.com/outside" } }] }
              ]
            },
            {
              "type": "heading",
              "attrs": { "id": "new-heading", "level": 1 },
              "content": [{ "type": "text", "text": "New heading", "marks": [{ "type": "italic" }] }]
            },
            {
              "type": "paragraph",
              "attrs": { "id": "new-body" },
              "content": [
                { "type": "text", "text": "New " },
                { "type": "text", "text": "body", "marks": [{ "type": "bold" }] },
                { "type": "hardBreak" },
                { "type": "text", "text": "continues", "marks": [{ "type": "link", "attrs": { "href": "https://example.com/scene" } }] }
