            {
              "type": "paragraph",
              "attrs": { "id": "before" },
              "content": [
                { "type": "text", "text": "Outside bold", "marks": [{ "type": "bold" }] },
                { "type": "text", "text": " and " },
                { "type": "text", "text": "link", "marks": [{ "type": "italic" }, { "type": "link", "attrs": { "href": "https://example.com/outside" } }] }
              ]
            },
            {
              "type": "heading",
              "attrs": { "id": "old-heading", "level": 2 },
              "content": [{ "type": "text", "text": "Old heading" }]
            },
            {
              "type": "paragraph",
              "attrs": { "id": "old-body" },
              "content": [{ "type": "text", "text": "Old body" }]
            },
            { "type": "sceneBreak", "attrs": { "id": "old-scene" } },
            {
              "type": "paragraph",
              "attrs": { "id": "after" },
              "content": [{ "type": "text", "text": "Outside after", "marks": [{ "type": "italic" }, { "type": "link", "attrs": { "href": "https://example.com/after" } }] }]
