        {
          "type": "heading",
          "attrs": { "level": 1 },
          "content": [
            { "type": "text", "text": "New heading", "marks": [{ "type": "italic" }] }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            { "type": "text", "text": "New " },
            { "type": "text", "text": "body", "marks": [{ "type": "bold" }] },
