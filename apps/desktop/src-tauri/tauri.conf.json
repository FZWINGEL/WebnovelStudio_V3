{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WebnovelStudio V3 Editor Trial",
  "version": "0.1.0",
  "identifier": "com.webnovelstudio.v3.editor-trial",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 1420 --strictPort",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node scripts/build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "create": false,
      "title": "WebnovelStudio V3 — Desktop preview",
      "width": 1240,
      "height": 840,
      "minWidth": 800,
      "minHeight": 600
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": { "active": false }
}
